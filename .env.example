# ATTENTION — ce dépôt est PUBLIC.
# Ce fichier est versionné : il ne doit contenir QUE des placeholders vides et
# des valeurs de développement jetables. Une valeur réelle commitée ici reste
# lisible dans l'historique git même après suppression : la seule remédiation
# est de la révoquer / régénérer côté fournisseur.
# Les vraies valeurs vont dans .env, qui est gitignoré.
#
# Copier en `.env` à la racine : c'est ce fichier que docker-compose lit pour
# résoudre les variables de compose.yml. `backend/.env` est un fichier distinct,
# utilisé seulement par les outils lancés depuis l'hôte (CLI Prisma).

# PostgreSQL — utilisés par docker-compose pour initialiser la base.
# postgres/postgres est un couple jetable, valable UNIQUEMENT pour le conteneur
# local (jamais exposé hors de la machine). À ne réutiliser sur aucun
# environnement partagé ou accessible depuis le réseau.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Port publié sur l'hôte. À changer si un autre PostgreSQL occupe déjà 5432 sur
# la machine, sinon le conteneur ne démarre pas ("port is already allocated").
# Le backend, lui, joint la base par le réseau Docker et n'est pas concerné.
POSTGRES_PORT=5432

# Connexion Prisma du conteneur backend. L'hôte est le nom du service Docker,
# pas localhost — la variante localhost est dans backend/.env.example.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# Port exposé du backend NestJS
PORT=3001

# OBLIGATOIRE — clé de signature des JWT.
# compose.yml la lit ici (JWT_SECRET), et l'API REFUSE DE DÉMARRER si elle est
# vide (backend/src/auth/auth.module.ts). Sans cette ligne renseignée dans le
# .env, `docker compose up` échoue au boot du backend.
# Générer une valeur propre :  openssl rand -base64 48
# Ne jamais commiter la valeur : ce fichier est public.
JWT_SECRET=

# Sentry (observabilité) — DSN du projet backend. Laisser vide pour désactiver :
# le SDK s'initialise alors en mode inerte, rien n'est transmis. À récupérer dans
# Sentry > Settings > Projects > <projet> > Client Keys (DSN).
SENTRY_DSN=

# Nombre de reverse proxies devant l'API. 0 (défaut) = accès direct.
# Voir backend/src/setup-app.ts : c'est ce qui décide de l'IP que le rate
# limiter compte. Mettre une valeur > 0 UNIQUEMENT si un proxy ajoute
# réellement autant d'entrées à X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Répertoire de stockage des fichiers téléversés (CV, photo de profil, logo,
# image de couverture). Ne PAS le placer sous /app : ce chemin est bind-monté
# depuis ./backend en dev, les fichiers atterriraient dans les sources et
# `nest start --watch` recompilerait à chaque upload.
# En dev comme en prod, compose monte le volume nommé `backend_uploads` ici.
# Laisser vide revient au défaut ci-dessous.
UPLOADS_DIR=/var/lib/rekr/uploads

# Front — facultatifs, compose.yml applique ces mêmes valeurs par défaut
VITE_API_TARGET=http://backend:3001
VITE_API_URL=/api

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=logs.raw

# URL publique du front. Sert à fabriquer le lien de réinitialisation de mot de
# passe envoyé par e-mail (${APP_URL}/reinitialiser-mot-de-passe?token=...).
APP_URL=http://localhost:8082

# Durée de vie d'un lien de réinitialisation, en minutes (défaut 60). Le lien
# est à usage unique et une nouvelle demande invalide la précédente.
PASSWORD_RESET_TTL_MINUTES=60

# Envoi d'e-mails (SMTP, via nodemailer).
# SMTP_HOST est l'interrupteur : vide, aucun e-mail ne part et le message est
# écrit dans les logs du backend — le lien de réinitialisation est alors lisible
# dans `docker compose logs backend`. Ce mode ne peut pas survivre à la mise en
# production : quiconque lit les logs pourrait réinitialiser n'importe quel
# compte, donc l'API REFUSE DE DÉMARRER si NODE_ENV=production et que SMTP_HOST
# est vide (même contrat que JWT_SECRET).
# SMTP_SECURE=true pour du TLS implicite (port 465), sinon STARTTLS sur 587.
# Ne jamais commiter d'identifiants ici : ce fichier est public, les vraies
# valeurs vont dans .env, qui est gitignoré.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rekr <no-reply@rekr.app>"
