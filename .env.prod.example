# Production variables for compose.prod.yml.
#
# ATTENTION — ce dépôt est PUBLIC. Ce fichier ne contient que des noms de
# variables : aucune valeur réelle ici, jamais.
#
# En production, personne n'écrit ce fichier à la main : le workflow
# .github/workflows/deploy.yml génère le `.env` du serveur à chaque déploiement,
# depuis l'environnement GitHub `production` (secrets et variables du même nom).
# Ce fichier est la liste de référence : une variable ajoutée ici s'ajoute aussi
# dans l'environnement GitHub et dans le workflow. Voir docs/deploiement-vps.md.
#
# compose.prod.yml refuse de démarrer si une variable obligatoire est vide.

# Domaine public servi par Caddy (sans https://). Ses enregistrements A et AAAA
# doivent pointer vers le serveur avant le premier démarrage.
DOMAIN=rekr.tech

# PostgreSQL. Le mot de passe entre dans DATABASE_URL : le générer en hexa pour
# qu'il ne contienne aucun caractère à encoder dans une URL.
#   openssl rand -hex 24
POSTGRES_USER=rekr
POSTGRES_PASSWORD=
POSTGRES_DB=rekr

# Clé de signature des JWT.  openssl rand -base64 48
JWT_SECRET=

# Envoi d'e-mails (Brevo). Port 587 en STARTTLS : Hetzner bloque 25 et 465 en
# sortie sur les nouveaux comptes Cloud.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rekr <no-reply@rekr.tech>"

# Elasticsearch. ELASTIC_PASSWORD protège le super-utilisateur `elastic`, qui
# ne sert qu'à créer la clé du backend :
#   openssl rand -hex 24
ELASTIC_PASSWORD=
# Clé d'API du backend, limitée à l'index des offres. Vide au premier
# démarrage : la créer avec docker/elasticsearch/create-api-key.sh, la coller
# ici, puis relancer le backend.
ELASTICSEARCH_API_KEY=
# true une seule fois, pour construire l'index depuis PostgreSQL. En production,
# c'est la case « Reconstruire l'index » du lancement manuel du workflow.
ELASTICSEARCH_REINDEX_ON_STARTUP=false

# Messagerie (Stream Chat), app Stream de PRODUCTION, région EU West, distincte
# de celle du développement. dashboard.getstream.io > <app> > App Access Keys.
# Le secret reste côté backend, jamais dans une variable VITE_.
STREAM_API_KEY=
STREAM_API_SECRET=

# Sentry (facultatif). Vide = SDK inerte.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
# DSN du projet front, inscrit dans le build par Vite.
VITE_SENTRY_DSN=
