# Production variables for compose.prod.yml.
#
# ATTENTION — ce dépôt est PUBLIC. Ce fichier ne contient que des noms de
# variables : aucune valeur réelle ici, jamais. Sur le serveur, le copier en
# `.env` à côté de compose.prod.yml (gitignoré), puis le protéger :
#   chmod 600 .env
# compose.prod.yml refuse de démarrer si une variable obligatoire est vide.

# Domaine public servi par Caddy (sans https://). Ses enregistrements A et AAAA
# doivent pointer vers le serveur avant le premier démarrage.
DOMAIN=rekr.tech

# PostgreSQL. Le mot de passe entre dans DATABASE_URL : le générer en hexa pour
# qu'il ne contienne aucun caractère à encoder dans une URL.
#   openssl rand -hex 24
POSTGRES_USER=rekr
POSTGRES_PASSWORD=
POSTGRES_DB=rekr

# Clé de signature des JWT.  openssl rand -base64 48
JWT_SECRET=

# Envoi d'e-mails (Brevo). Port 587 en STARTTLS : Hetzner bloque 25 et 465 en
# sortie sur les nouveaux comptes Cloud.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rekr <no-reply@rekr.tech>"

# Elasticsearch. ELASTIC_PASSWORD protège le super-utilisateur `elastic`, qui
# ne sert qu'à créer la clé du backend :
#   openssl rand -hex 24
ELASTIC_PASSWORD=
# Clé d'API du backend, limitée à l'index des offres. Vide au premier
# démarrage : la créer avec docker/elasticsearch/create-api-key.sh, la coller
# ici, puis relancer le backend.
ELASTICSEARCH_API_KEY=
# true une seule fois, pour construire l'index depuis PostgreSQL.
ELASTICSEARCH_REINDEX_ON_STARTUP=false

# Sentry (facultatif). Vide = SDK inerte.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
# DSN du projet front, inscrit dans le build par Vite.
VITE_SENTRY_DSN=
