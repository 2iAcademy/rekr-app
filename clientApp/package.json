    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.7",
    "stream-chat": "^9.54.0",
    "stream-chat-react": "^14.13.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.2",
