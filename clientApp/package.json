    "format:check": "prettier --check .",
    "preview": "vite preview",
    "generate-api": "orval"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@sentry/react": "^10.76.2",
