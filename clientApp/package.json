    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "orval": "^8.22.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2",
