# ATTENTION — ce dépôt est PUBLIC.
# Ce fichier est versionné : il ne doit contenir QUE des placeholders vides et
# des valeurs de développement jetables. Une valeur réelle commitée ici reste
# lisible dans l'historique git même après suppression : la seule remédiation
# est de la révoquer / régénérer côté fournisseur.
# Les vraies valeurs vont dans clientApp/.env, qui est gitignoré.

# Sentry (observabilité) — laisser vide pour désactiver.
# Où récupérer la valeur : Sentry > Settings > Projects > <projet frontend>
# > Client Keys (DSN). À coller dans clientApp/.env, jamais ici.
# Rappel : un DSN front est de toute façon exposé dans le bundle livré au
# navigateur ; le committer ajoute quand même du bruit et des quotas brûlés
# par n'importe qui, donc on le garde hors du dépôt.
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT=development
VITE_API_TARGET=http://localhost:3001
VITE_API_URL=/api

