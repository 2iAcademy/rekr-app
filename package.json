{
  "name": "rekr-app-tools",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "clientApp/**/*.{ts,tsx}": [
      "clientApp/node_modules/.bin/eslint --config clientApp/eslint.config.js --fix",
      "prettier --write"
    ],
    "backend/**/*.{ts,js}": [
      "npm run eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
