{
  "name": "rekr-app-tools",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "clientApp/**/*.{ts,tsx}": [
      "npx --prefix clientApp eslint --fix"
    ],
    "backend/**/*.{ts,js}": [
      "npx --prefix backend eslint --fix",
      "npx --prefix backend prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  }
}
