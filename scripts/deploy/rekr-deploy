#!/usr/bin/env bash
# The only program the `deploy` account can run on the server, installed by an
# administrator as /usr/local/bin/rekr-deploy, owned by root: the account it
# serves cannot rewrite it. The SSH key of the CI is pinned to it in
# ~deploy/.ssh/authorized_keys:
#
#   restrict,command="/usr/local/bin/rekr-deploy" ssh-ed25519 …
#
# so whatever a connection asks for lands here, in SSH_ORIGINAL_COMMAND, and
# the only request accepted is `deploy <40-hex commit>`. The production `.env`
# comes in on standard input, generated by the CI from the GitHub `production`
# environment: nobody edits it by hand.
#
# Nothing is built here. The script checks that the commit is on main, takes
# compose.prod.yml from that very commit, and pulls the images the CI pushed
# under its hash. A leaked key can therefore only redeploy code that was
# reviewed and merged, never images or a compose file of its own.
#
# /opt/rekr holds three things: .env, compose.prod.yml, and repo.git, a bare
# copy of the repository used only to check commits and read compose.prod.yml.
set -euo pipefail

APP_DIR="${REKR_APP_DIR:-/opt/rekr}"
REPO_URL="${REKR_REPO_URL:-https://github.com/2iAcademy/rekr-app.git}"
DEPLOY_BRANCH=main
# Shared with the administrators through the `docker` group
# (docs/deploiement-vps.md): what this script writes stays group-readable.
SHARED_GROUP="${REKR_SHARED_GROUP:-docker}"
umask 002
# A real .env is a few kilobytes; anything far bigger is not one.
MAX_ENV_BYTES=65536

fail() {
  echo "rekr-deploy: $*" >&2
  exit 1
}

read -r action sha extra <<<"${SSH_ORIGINAL_COMMAND:-}" || true
[[ "${action:-}" == deploy ]] || fail "expected 'deploy <commit>'"
[[ -z "${extra:-}" ]] || fail "unexpected arguments"
[[ "${sha:-}" =~ ^[0-9a-f]{40}$ ]] || fail "expected a full 40-character commit hash"

cd "$APP_DIR"
repo="$APP_DIR/repo.git"

if [[ ! -d "$repo" ]]; then
  git clone --quiet --bare --single-branch --branch "$DEPLOY_BRANCH" "$REPO_URL" "$repo"
fi
git -C "$repo" fetch --quiet origin "+refs/heads/$DEPLOY_BRANCH:refs/heads/$DEPLOY_BRANCH"
git -C "$repo" merge-base --is-ancestor "$sha" "$DEPLOY_BRANCH" 2>/dev/null ||
  fail "commit $sha is not on $DEPLOY_BRANCH"

# Everything is prepared next to its final place, checked, then renamed over
# it: a deploy cut short leaves the previous files whole.
compose_tmp="$(mktemp "$APP_DIR/.compose.XXXXXX")"
env_tmp="$(mktemp "$APP_DIR/.env.XXXXXX")"
trap 'rm -f "$compose_tmp" "$env_tmp"' EXIT

git -C "$repo" show "$sha:compose.prod.yml" >"$compose_tmp"

head -c "$((MAX_ENV_BYTES + 1))" >"$env_tmp"
env_size="$(wc -c <"$env_tmp")"
((env_size > 0)) || fail "no .env received on standard input"
((env_size <= MAX_ENV_BYTES)) || fail ".env larger than $MAX_ENV_BYTES bytes"
# The image tag is the commit checked above, never a value from the input.
sed -i '/^IMAGE_TAG=/d' "$env_tmp"
printf "IMAGE_TAG='%s'\n" "$sha" >>"$env_tmp"

chgrp "$SHARED_GROUP" "$compose_tmp" "$env_tmp"
chmod 644 "$compose_tmp"
chmod 640 "$env_tmp"

# Pulled before anything is replaced: a missing image stops the deploy here,
# with the running version untouched.
docker compose -f "$compose_tmp" --env-file "$env_tmp" pull --quiet
# Compose only warns when an image with a `build` section fails to pull.
while read -r image; do
  docker image inspect "$image" >/dev/null 2>&1 || fail "image $image could not be pulled"
done < <(docker compose -f "$compose_tmp" --env-file "$env_tmp" config --images)

mv -f "$compose_tmp" "$APP_DIR/compose.prod.yml"
mv -f "$env_tmp" "$APP_DIR/.env"
trap - EXIT

docker compose -f compose.prod.yml up -d --no-build --remove-orphans
# The server has a small disk: drop the images no container uses, once older
# than a week. The recent ones stay, so a rollback rarely needs a download.
docker image prune -af --filter "until=168h" >/dev/null

echo "rekr-deploy: $sha deployed"
