# Connexion Prisma (lancé depuis l'hôte → localhost ; mêmes creds que rekr-app/.env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Port du serveur NestJS
PORT=3001

# ATTENTION — ce dépôt est PUBLIC.
# Ce fichier est versionné : il ne doit contenir QUE des placeholders vides et
# des valeurs de développement jetables. Une valeur réelle commitée ici reste
# lisible dans l'historique git même après suppression : la seule remédiation
# est de la révoquer / régénérer côté fournisseur.
# Les vraies valeurs vont dans backend/.env, qui est gitignoré.

# Auth — clé de signature des JWT.
# Génère la tienne (local comme déploiement) : openssl rand -base64 48
# Laisser vide fait échouer le démarrage de l'API avec un message explicite
# ("JWT_SECRET is required to start the API." — voir src/auth/auth.module.ts).
JWT_SECRET=""

# Sentry (observabilité) — laisser vide pour désactiver en local.
# Où récupérer la valeur : Sentry > Settings > Projects > <projet backend>
# > Client Keys (DSN). À coller dans backend/.env, jamais ici.
SENTRY_DSN=""

# Kafka
KAFKA_BOOTSTRAP_SERVERS="localhost:29092"
KAFKA_TOPIC="logs.raw"
KAFKA_GROUP_ID="rekr-logs-sink"

# Nombre de reverse proxies devant l'API. Decide de l'adresse que le rate
# limiter compte (req.ip).
#   0 (defaut) : API joignable en direct.
#   n > 0      : Express remonte n entrees depuis la DROITE de X-Forwarded-For.
# A regler AVANT toute mise derriere un ingress / nginx / Cloud Run : sinon
# tous les clients partagent l'IP du proxy et 5 mauvais logins bloquent la
# connexion de tout le monde. Ne jamais utiliser "true" : l'en-tete devient
# falsifiable et le rate limit disparait.
TRUST_PROXY_HOPS=0

# Rate limiting (laisser vide pour les valeurs par defaut)
# Fenetre commune, en secondes
THROTTLE_TTL_SECONDS=60
# Budget par route et par IP sur une fenetre
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_LOGIN_LIMIT=5
THROTTLE_SIGNUP_LIMIT=10
THROTTLE_LOGS_LIMIT=20
# Autocomplétion de commune : une requête par frappe débouncée, multipliée par
# le nombre de personnes derrière une même IP. Les réponses sont mises en cache
# côté serveur, donc une rafale coûte peu.
THROTTLE_CITIES_LIMIT=200

# Durée de vie glissante du refresh token, en jours.
REFRESH_TOKEN_TTL_DAYS=30

# Fenêtre pendant laquelle un token déjà tourné répond encore, en resservant le
# successeur que la rotation gagnante a émis. Absorbe la course entre deux
# onglets qui renouvellent au même instant sans ouvrir de seconde session : les
# deux appelants repartent avec le même token.
REFRESH_TOKEN_REPLAY_SECONDS=10

# Budget de requêtes du scope `refresh`, par IP et par fenêtre de throttling.
THROTTLE_REFRESH_LIMIT=30

# Budget du scope `files` (GET /api/files), par IP et par fenêtre. Compté par
# image affichée et non par action utilisateur : une page qui montre 30 logos
# consomme 30 requêtes. D'où un budget bien plus large que les autres.
THROTTLE_FILES_LIMIT=600

# Répertoire de stockage des fichiers téléversés (CV, photo, logo, couverture).
# Utile seulement si l'API est lancée depuis l'hôte : dans le conteneur, la
# valeur vient de compose.yml et pointe vers le volume nommé `backend_uploads`.
# Ne jamais viser un chemin sous ./backend : les fichiers finiraient dans les
# sources et le watcher de Nest recompilerait à chaque upload.
UPLOADS_DIR=/var/lib/rekr/uploads

# Budget du scope `passwordForgot` (POST /api/auth/password/forgot), par IP et
# par fenêtre. Plus serré que les autres : chaque requête acceptée envoie un
# e-mail à une adresse choisie par l'appelant.
THROTTLE_PASSWORD_FORGOT_LIMIT=5

# Budget du scope `passwordReset` (POST /api/auth/password/reset), par IP et par
# fenêtre. Plus large : rien ne sort du système, le plafond sert seulement à
# empêcher de balayer l'espace des jetons.
THROTTLE_PASSWORD_RESET_LIMIT=10

# Durée de vie d'un lien de réinitialisation de mot de passe, en minutes.
# Laisser vide pour 60. Le lien est à usage unique : une nouvelle demande
# invalide la précédente.
PASSWORD_RESET_TTL_MINUTES=60

# URL publique du front. Sert à fabriquer le lien envoyé par e-mail
# (${APP_URL}/reinitialiser-mot-de-passe?token=...). Laisser vide revient au
# défaut de développement, http://localhost:8082.
APP_URL=http://localhost:8082

# Envoi d'e-mails (SMTP, via nodemailer).
# SMTP_HOST est l'interrupteur : tant qu'il est vide, aucun e-mail ne part et le
# message est simplement écrit dans les logs du serveur — pratique en local, où
# le lien de réinitialisation est alors lisible dans le terminal. Ce mode ne
# peut pas rester actif en production : quiconque lit les logs pourrait
# réinitialiser n'importe quel compte, donc l'API REFUSE DE DÉMARRER si
# NODE_ENV=production et que SMTP_HOST est vide (même contrat que JWT_SECRET).
# SMTP_SECURE=true pour du TLS implicite (port 465) ; sinon STARTTLS sur 587.
# Les identifiants sont des secrets : ce fichier est PUBLIC, les vraies valeurs
# vont dans backend/.env, qui est gitignoré.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rekr <no-reply@rekr.app>"
