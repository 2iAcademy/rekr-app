#!/usr/bin/env sh
set -e

echo "Running frontend type-check..."
docker compose exec -T frontend npm run type-check

echo "Running frontend lint..."
docker compose exec -T frontend ./node_modules/.bin/eslint .

echo "Running frontend tests..."
docker compose exec -T frontend npm run test

echo "Running backend lint..."
docker compose exec -T backend ./node_modules/.bin/eslint "{src,apps,libs,test}/**/*.ts"

echo "Running backend tests..."
docker compose exec -T backend npm run test

echo "All pre-push checks passed"